{
  "redirects": [
    { "source": "/", "destination": "/stethoscribe", "permanent": false },
    {
      "source": "/medical-scribe/demo",
      "destination": "/stethoscribe/medical-scribe/demo",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/stethoscribe/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/stethoscribe/:file.:ext", "destination": "/:file.:ext" },
    { "source": "/stethoscribe", "destination": "/index.html" },
    { "source": "/stethoscribe/", "destination": "/index.html" },
    { "source": "/stethoscribe/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "microphone=(self)" }
      ]
    }
  ]
}
